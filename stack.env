# Portainer lê este arquivo ao deploy via Git.
# TROQUE os valores CHANGE_ME antes do primeiro deploy (ou sobrescreva na UI do Portainer).

POSTGRES_USER=lancex
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_SENHA_FORTE
POSTGRES_DB=lancex

API_PUBLISH_PORT=3001
LANCEX_IMAGE_TAG=latest

# Front Vercel (URL exata, sem barra no final). Ajuste quando tiver o domínio.
CORS_ORIGIN=https://radar-leilao.vercel.app

JWT_ACCESS_SECRET=CHANGE_ME_JWT_ACCESS_MIN_32_CARACTERES_AQUI
JWT_REFRESH_SECRET=CHANGE_ME_JWT_REFRESH_MIN_32_CARACTERES_AQUI
SETTINGS_ENCRYPTION_KEY=CHANGE_ME_SETTINGS_KEY_32CHARS

JOBS_ENABLED=true
