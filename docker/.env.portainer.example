# Copie para Portainer (Stack → Environment variables) ou .env no servidor.
# NUNCA commite senhas reais.

POSTGRES_USER=lancex
POSTGRES_PASSWORD=troque-por-senha-forte-postgres
POSTGRES_DB=lancex

API_PUBLISH_PORT=3001
LANCEX_IMAGE_TAG=latest

# URL do front na Vercel (sem barra final). Vários domínios: separar por vírgula.
CORS_ORIGIN=https://radar-leilao.vercel.app

JWT_ACCESS_SECRET=troque-access-secret-minimo-32-caracteres
JWT_REFRESH_SECRET=troque-refresh-secret-minimo-32-caracteres
SETTINGS_ENCRYPTION_KEY=troque-chave-32-chars-integracoes

JOBS_ENABLED=true

# Opcional — primeira carga (depois remova da stack)
# SEED_ADMIN_EMAIL=admin@lancex.app
# SEED_ADMIN_PASSWORD=ChangeMeAdmin123!

TAVILY_API_KEY=
AI_API_KEY=
