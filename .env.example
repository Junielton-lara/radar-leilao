# Database (PostGIS)
DATABASE_URL=postgresql://lancex:lancex@localhost:5432/lancex?schema=public
# Docker Compose mapeia Postgres em 5433 se a porta 5432 já estiver em uso:
# DATABASE_URL=postgresql://lancex:lancex@localhost:5433/lancex?schema=public

# Redis (reserved for Phase 5)
REDIS_URL=redis://localhost:6379

# API
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Seed admin (Phase 1)
SEED_ADMIN_EMAIL=admin@lancex.app
SEED_ADMIN_PASSWORD=ChangeMeAdmin123!
SEED_ADMIN_NAME=Administrador LanceX

# Web (local)
VITE_API_URL=http://localhost:3001/api/v1

# Produção — Vercel: defina no painel da Vercel (não commitar URL real aqui)
# VITE_API_URL=https://api.seudominio.com/api/v1

# Tavily (FASE 3) — never expose to frontend
TAVILY_API_KEY=
TAVILY_DAILY_LIMIT=100
TAVILY_MONTHLY_LIMIT=2000

# AI Intelligence Engine (FASE 4) — OpenAI-compatible
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=4000
AI_DAILY_COST_LIMIT_USD=20

# Jobs (FASE 5)
JOBS_ENABLED=true
DISCOVERY_CRON=0 3 * * *
MONITORING_CRON=0 */6 * * *
STATUS_CRON=0 * * * *

# Credential encryption (FASE 6)
SETTINGS_ENCRYPTION_KEY=change-me-32-char-encryption-key!!
